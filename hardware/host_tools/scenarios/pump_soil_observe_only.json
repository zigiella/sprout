{
  "id": "pump_soil_observe_only",
  "description": "Lectura segura sin riego: estado de bomba OFF y humedad real.",
  "startup_capture_s": 0.8,
  "steps": [
    {
      "type": "command",
      "name": "estado_inicial_bomba",
      "send": "PUMP_STATUS",
      "expect_all": [
        "PUMP_REPORT gpio=16",
        "state=OFF",
        "execution=TEST_ONLY"
      ]
    },
    {
      "type": "command",
      "name": "humedad_1",
      "send": "SOIL_READ",
      "expect_all": [
        "SOIL_REPORT soil_a_raw=",
        "soil_a_source=ADC",
        "soil_a_gpio=4"
      ]
    },
    {
      "type": "command",
      "name": "telemetria",
      "send": "TELEMETRY",
      "expect_all": [
        "TELEMETRY_REPORT soil_a_raw=",
        "soil_a_source=ADC",
        "soil_a_gpio=4"
      ]
    },
    {
      "type": "command",
      "name": "apagado_final",
      "send": "PUMP_OFF",
      "expect_all": [
        "ACK command=PUMP_OFF"
      ]
    },
    {
      "type": "command",
      "name": "estado_final_seguro",
      "send": "PUMP_STATUS",
      "expect_all": [
        "PUMP_REPORT gpio=16",
        "state=OFF"
      ]
    }
  ]
}

menu "Sprout firmware"

choice SPROUT_BOARD_PROFILE
    prompt "Sprout board profile"
    default SPROUT_BOARD_PROFILE_N16R8_USB_OTG
    help
        Select the physical ESP32-S3 board profile without coupling the
        firmware state machine to a single board layout.

    config SPROUT_BOARD_PROFILE_N16R8_USB_OTG
        bool "ESP32-S3 N16R8 USB OTG"

    config SPROUT_BOARD_PROFILE_DEVKITC_N8R8
        bool "ESP32-S3-DevKitC-1 N8R8"
endchoice

config SPROUT_HEARTBEAT_INTERVAL_MS
    int "Heartbeat interval (ms)"
    range 500 10000
    default 2000
    help
        Cadence for HEARTBEAT lines emitted by the milestone-0 firmware.

config SPROUT_COMMAND_MAX_LINE_LENGTH
    int "Maximum serial command length"
    range 32 512
    default 128
    help
        Maximum ASCII line length accepted from the host for the hito-0
        serial protocol.

config SPROUT_HOST_HEARTBEAT_TIMEOUT_MS
    int "Host heartbeat freshness timeout (ms)"
    range 1000 60000
    default 5000
    help
        Maximum age of the most recent host heartbeat before the Rhizome
        link is considered stale.

config SPROUT_TANK_MINIMUM_PCT
    int "Minimum tank level percentage"
    range 0 100
    default 20
    help
        Hard floor for the reservoir level. Watering commands are rejected
        when the current tank level percentage is known and falls below
        this threshold.

config SPROUT_MAX_WATER_SECONDS
    int "Maximum watering seconds per event"
    range 1 600
    default 30
    help
        Hard upper bound for a single WATER event in the ESP32 safety layer.

endmenu
